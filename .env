# Podcast Clip Agent - Environment Variables
# Copy this file and fill in your actual credentials

# REQUIRED: OpenAI API Keys
# ----------------------------------------
# Both keys can be the same if you want

# For AI viral moment detection (GPT-4o-mini)
OPENAI_API_KEY=

# For audio transcription (Whisper API)
# Can be the same as OPENAI_API_KEY above
OPENAI_WHISPER_KEY=

# Optional: Advanced Configuration
# ----------------------------------------
# These are handled by marketplace, not needed in .env

# Number of clips to create (1-10)
# NUM_CLIPS=3

# Max clip duration in seconds (10-180)
# MAX_DURATION=60

# Min clip duration in seconds (5-120)
# MIN_DURATION=15

# Aspect ratio: "9:16" (vertical), "1:1" (square), or "16:9" (horizontal)
# ASPECT_RATIO=9:16

# Virality threshold (1.0-10.0)
# VIRALITY_THRESHOLD=7.0

# Add captions (true/false)
# ADD_CAPTIONS=true
